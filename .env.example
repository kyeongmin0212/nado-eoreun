# 나도으른 — 환경변수 이름만 적는다. 실제 값은 커밋하지 않는 .env.local, 배포 환경변수, GitHub Secrets에 넣는다.
# RELEASE_ID·SEED_USER_*·AI_GATEWAY_API_KEY 는 주최 측 실행과 CI가 그대로 읽으므로 이름을 바꾸지 않는다.

# --- 배포 상태 ---
# 지금 돌고 있는 버전(commit SHA). /__health 의 releaseId 로 응답한다. Vercel 은 VERCEL_GIT_COMMIT_SHA 를 자동 제공한다.
RELEASE_ID=

# --- Supabase (필수) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase 대시보드 > Project Settings > API Keys 의 publishable key(sb_publishable_...) 또는 legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. legacy service_role key(JWT) 를 사용한다. 새 secret key(sb_secret_...)는 Auth 관리 API(seed)에서 거부됨(2026-10-29 확인). 클라이언트 번들 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- 이미지 생성 ---
# 기본: OpenAI API 직접 호출. https://platform.openai.com/api-keys 에서 발급. 서버 전용.
OPENAI_API_KEY=
# 기본 모델. 임의로 다른 공급자로 바꾸지 않는다.
IMAGE_MODEL_ID=gpt-image-2.5-sunburst
# 선택: low | medium | high | xhigh | max (비우면 모델 기본값)
IMAGE_QUALITY=medium
# 대체 경로: OPENAI_API_KEY 가 없고 아래 키가 있으면 Vercel AI Gateway(openai/gpt-image-2.5-sunburst)로 호출.
# 주최 측 실행·CI 는 이 이름으로 키를 넣는다. 학생이 대시보드 자료 → API 키에서 직접 발급한다.
AI_GATEWAY_API_KEY=

# --- 앱 origin / Web Push ---
# 배포 도메인(예: https://nado-eoreun.vercel.app). 로컬은 http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# `pnpm vapid:generate` 로 생성. 공개키는 클라이언트에 노출되지만 개인키는 서버 전용.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 운영자 연락처. mailto:you@example.com 또는 https://도메인 형식의 유효한 URI.
VAPID_SUBJECT=

# --- 통금 알림 스케줄러 ---
# /api/cron/curfew 를 호출하는 스케줄러(pg_cron 등)가 x-cron-secret 헤더로 보내는 값. `openssl rand -hex 24` 로 생성.
CRON_SECRET=
# docker(local) 모드는 서버 안 타이머가 1분마다 실행한다. 끄려면 off, Supabase 모드에서 로컬 개발 중 켜려면 inprocess.
CURFEW_SCHEDULER=

# --- 테스트 계정 초기화 (scripts/seed-demo.ts 전용, UI에 전달되지 않음) ---
DEMO_USER_1_EMAIL=
DEMO_USER_1_PASSWORD=
DEMO_USER_1_NAME=테스트 사용자 1
DEMO_USER_2_EMAIL=
DEMO_USER_2_PASSWORD=
DEMO_USER_2_NAME=테스트 사용자 2
DEMO_USER_3_EMAIL=
DEMO_USER_3_PASSWORD=
DEMO_USER_3_NAME=테스트 사용자 3

# --- 주최 측 docker 실행용 (docker-compose.yml 에 값을 직접 적는다. 여기서는 이름만) ---
# 로컬 docker 앱이 처음 뜰 때 만드는 시드 계정(E2E 로그인용). 배포 사이트의 실제 계정과 같은 비밀번호를 쓰지 않는다.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# docker 내부 DB 연결 주소 (docker 모드 구성 시 사용)
DATABASE_URL=

# 가입 인증번호 메일 (SMTP). 비우면 회원가입 화면이 '이메일 발송 연결 대기'로 막힌다.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=Gmail 주소, SMTP_PASS=앱 비밀번호
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
